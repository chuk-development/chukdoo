<?xml version="1.0" encoding="utf-8"?>
<!-- Static twin of the real layout, used for android:previewLayout. A preview
     cannot run a RemoteViewsService, so the rows are written out by hand. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="2dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textColor="@color/widget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mon, 8 Sep"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:src="@drawable/ic_widget_plus"
            android:background="@drawable/widget_action_bg"
            android:contentDescription="Calendar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_first"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="09:00"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <View
            android:layout_width="4dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="#FF64B5F6" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Standup"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_middle"
        android:layout_marginTop="@dimen/widget_group_gap"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="13:30"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <View
            android:layout_width="4dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="#FFB388FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dentist"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_row_last"
        android:layout_marginTop="@dimen/widget_group_gap"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="18:00"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <View
            android:layout_width="4dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="#FFFFB74D" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Gym session"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
