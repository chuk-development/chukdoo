<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_item_background">

    <ImageView
        android:id="@+id/widget_todo_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/checkbox_off_background"
        android:contentDescription="Erledigt"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_todo_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F0F0F5"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_todo_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9898A6"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/widget_todo_priority"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:background="#FF5252"
        android:layout_marginStart="8dp" />

</LinearLayout>
